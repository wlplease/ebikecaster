# CasterCycle environment

# Public app URL. Keep this aligned with the Farcaster account association domain.
NEXT_PUBLIC_APP_URL=https://castercycle.vercel.app

# Farcaster-native Mini App URL used in cast text and share embeds.
# The manifest castShareUrl is intentionally same-domain with NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SHARE_URL=https://farcaster.xyz/miniapps/_U8dgupnJBvv/castercycle

# Required for a verified Farcaster Mini App on castercycle.vercel.app.
# Generate these by signing the Farcaster manifest for this exact domain.
FARCASTER_ACCOUNT_ASSOCIATION_HEADER=eyJmaWQiOjEwNTkwNzUsInR5cGUiOiJhdXRoIiwia2V5IjoiMHg3NmJDNzVFZjJGMWYwRjI1ZTA3ODY0MTkxMEQ4RTIzQTQzMDIwNEY1In0
FARCASTER_ACCOUNT_ASSOCIATION_PAYLOAD=eyJkb21haW4iOiJjYXN0ZXJjeWNsZS52ZXJjZWwuYXBwIn0
FARCASTER_ACCOUNT_ASSOCIATION_SIGNATURE=boulOy0OdjQHe1jiMb0bAzbg4daYKAZoBkZmiTjmmIgccXjBqxR0iB/KsFnjIoPkHsuxOsRya6iu2Wk+wfp2rxs=

# Public Firebase client config for server-backed scores, lounge, and claims.
# No Firebase service account key is used by this app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Required for friend leaderboard filtering. Without it, friends view falls back empty/global-safe.
NEYNAR_API_KEY=

# Optional custom Base RPC for wallet reads/writes.
NEXT_PUBLIC_BASE_RPC_URL=

# Base treasury wallet. Receives direct Base USDC pass payments and optional ETH support.
NEXT_PUBLIC_TREASURY_ADDRESS=0x76bC75Ef2F1f0F25e078641910D8E23A430204F5

# Optional Kingbull Ranger fan quest coupon display.
NEXT_PUBLIC_KINGBULL_COUPON_CODE=GET50OFF

# Optional gameplay credits contract. Users pay gas when claiming verified ride/share credits.
NEXT_PUBLIC_CASTER_CREDITS_CONTRACT=
NEXT_PUBLIC_CASTER_CREDITS_CHAIN_ID=8453
REWARD_SIGNER_PRIVATE_KEY=
REWARD_MAX_RIDE_CREDITS=300
REWARD_SHARE_CREDITS=25

# Optional owner-funded token trophy vault. Closed Daily Dash winners can claim if funded and signed.
NEXT_PUBLIC_TOKEN_TROPHY_VAULT=
NEXT_PUBLIC_TOKEN_TROPHY_CHAIN_ID=8453
TOKEN_TROPHY_SIGNER_PRIVATE_KEY=
TOKEN_TROPHY_DAILY_AMOUNT=1
TOKEN_TROPHY_WEEKLY_AMOUNT=2
TOKEN_TROPHY_MIN_SCORE=2500

# Optional e-bike token holder perks.
# CasterCycle only reads balance for cosmetics/social flair. It does not sell, swap, custody, price, stake, or promise rewards.
NEXT_PUBLIC_EBIKE_TOKEN_ADDRESS=0x1471C903A19Ea87097e4523924D17F2C5Ead2B07
NEXT_PUBLIC_EBIKE_TOKEN_SYMBOL=EBIKE
NEXT_PUBLIC_EBIKE_TOKEN_DECIMALS=18
NEXT_PUBLIC_EBIKE_TOKEN_INFO_URL=
NEXT_PUBLIC_EBIKE_TOKEN_MARKET_URL=

# Optional route voiceovers. These stay server-side and are never exposed to the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_MARA=iEbJsqzb6jw8MYxZ2xca
ELEVENLABS_VOICE_PRIYA=atf1ppeJGCYFBlCLZ26e
