# ═══════════════════════════════════
# nSh3// Environment Variables
# ═══════════════════════════════════

# Neynar API Key (required for /whois, /followers, /channel, /trending, /search)
# Get your API key from https://dev.neynar.com/
NEYNAR_API_KEY=your_api_key_here

# Base RPC URL (optional, for /balances)
# Get a free RPC URL from https://www.alchemy.com/ or https://www.quicknode.com/
NEXT_PUBLIC_BASE_RPC_URL=

# Treasury address (Base) — receives USDC for Pro Pass purchases
# Used by /upgrade command to display payment address
NEXT_PUBLIC_TREASURY_ADDRESS=
