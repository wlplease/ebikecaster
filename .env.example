# CasterCycle environment

# Public app URL. Keep this aligned with the Farcaster account association domain.
NEXT_PUBLIC_APP_URL=https://ebikecaster.vercel.app

# Required for a verified Farcaster Mini App on ebikecaster.vercel.app.
# Generate these by signing the Farcaster manifest for this exact domain.
FARCASTER_ACCOUNT_ASSOCIATION_HEADER=eyJmaWQiOjEwNTkwNzUsInR5cGUiOiJhdXRoIiwia2V5IjoiMHg3NmJDNzVFZjJGMWYwRjI1ZTA3ODY0MTkxMEQ4RTIzQTQzMDIwNEY1In0
FARCASTER_ACCOUNT_ASSOCIATION_PAYLOAD=eyJkb21haW4iOiJlYmlrZWNhc3Rlci52ZXJjZWwuYXBwIn0
FARCASTER_ACCOUNT_ASSOCIATION_SIGNATURE=z6Nv35E2261R/UQGA5R78OXF5Fa+txVlURQzbNebQEFiH9NJP07xJkvBTGyT2Rf/Pd1TxrY9Jl2SPlWlLYmE+Rs=

# Required for server-backed scores and blocked-region logging.
# Store the full Firebase service account JSON string in your deployment secrets.
FIREBASE_SERVICE_ACCOUNT=

# Required for friend leaderboard filtering. Without it, friends view falls back empty/global-safe.
NEYNAR_API_KEY=

# Optional custom Base RPC for wallet reads/writes.
NEXT_PUBLIC_BASE_RPC_URL=

# Base treasury wallet. Receives direct Base ETH support payments.
NEXT_PUBLIC_TREASURY_ADDRESS=

# Public Firebase client config, only needed if client-side Firebase logging is used.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
